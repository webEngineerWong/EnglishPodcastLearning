# ===== API (apps/api) =====
DATABASE_URL=postgresql://elp:elp_dev_password@localhost:5433/elp?schema=public
PORT=3001
WEB_ORIGIN=http://localhost:3000
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data/storage
MAX_UPLOAD_MB=200
DEFAULT_USER_EMAIL=local@elp.dev
# 留空自动定位 services/pdf-parser 及其 venv
PDF_PARSER_PYTHON=
PDF_PARSER_SCRIPT=

# ===== Cloudflare R2 (可选, STORAGE_DRIVER=r2 时必填) =====
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_SIGNED_URL_TTL=3600

# ===== Web (apps/web) =====
NEXT_PUBLIC_API_URL=http://localhost:3001
